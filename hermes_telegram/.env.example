# Telegram API credentials — get them at https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+33XXXXXXXXX

# Ollama endpoint (default: local)
OLLAMA_HOST=http://localhost:11434

# Hermes model name as registered in Ollama (run: ollama list)
HERMES_MODEL=nous-hermes2

# Session file path (keep outside of repo)
SESSION_PATH=/home/user/.hermes_telegram_session

# System prompt for the agent
SYSTEM_PROMPT=You are a helpful AI assistant running on a personal VPS. Answer concisely and clearly.

# Whitelist: only respond to messages from these Telegram usernames (comma-separated, leave empty to respond to yourself only)
ALLOWED_USERNAMES=
